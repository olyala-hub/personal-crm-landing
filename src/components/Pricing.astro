---
import CtaButton from "./ui/CtaButton.astro";
import SectionTitle from "./ui/SectionTitle.astro";
import { plans } from "../data/content";
---

<section id="pricing" class="flex scroll-mt-20 flex-col gap-2 lg:gap-4">
  <SectionTitle class="mx-2 mt-3 mb-1 lg:mt-8 lg:mb-2">Простые тарифы</SectionTitle>
  <div
    class="flex flex-col gap-2 lg:grid lg:grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] lg:gap-3"
  >
    {
      plans.map((plan) => (
        <article
          class:list={[
            "flex flex-col gap-3.5 rounded-20 bg-surface p-5 lg:gap-4.5 lg:p-7",
            plan.popular && "ring-2 ring-primary ring-inset",
          ]}
        >
          <div class="flex items-start justify-between lg:gap-3">
            <div class="flex flex-col gap-1">
              <h3 class="text-17 font-semibold lg:text-20">{plan.name}</h3>
              <p class="text-14 text-ink-tertiary lg:text-15">{plan.subtitle}</p>
            </div>
            {plan.popular && (
              <span class="rounded-6 bg-primary px-2 py-1 text-12 font-semibold text-white">
                Популярный
              </span>
            )}
          </div>
          <div class="flex items-baseline gap-1.5 lg:gap-2">
            <span class="text-32 font-bold tracking-tighter lg:text-40">{plan.price}</span>
            {plan.period && <span class="text-14 text-ink-tertiary lg:text-15">{plan.period}</span>}
          </div>
          <ul class="flex flex-col gap-2 text-15 text-ink lg:flex-1 lg:gap-2.5 lg:text-16">
            {plan.items.map((item) => (
              <li>· {item}</li>
            ))}
          </ul>
          <CtaButton variant={plan.ctaVariant} class="h-12 text-16 lg:h-13">
            {plan.cta}
          </CtaButton>
        </article>
      ))
    }
  </div>
  <p class="mx-2 mt-1 text-13 text-ink-secondary lg:mt-0 lg:text-14">
    Скидка 30% при оплате «Плюс» за год.
  </p>
</section>

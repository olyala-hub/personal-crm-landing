---
import { APP_URL } from "../config";

const navLinks = [
  { label: "Возможности", href: "#features" },
  { label: "Как начать", href: "#how" },
  { label: "Тарифы", href: "#pricing" },
  { label: "Вопросы", href: "#faq" },
];
---

<header class="sticky top-0 z-5 border-b border-divider bg-surface">
  <div
    class="mx-auto flex h-14 max-w-mobile items-center justify-between px-4 lg:h-16 lg:max-w-page lg:gap-6 lg:px-6"
  >
    <div class="flex items-center gap-2 lg:gap-2.5">
      <div
        class="flex size-7 items-center justify-center rounded-full bg-primary text-15 font-bold text-white lg:size-8 lg:text-17"
        aria-hidden="true"
      >
        Л
      </div>
      <div class="text-17 font-bold lg:text-19">Лучшая CRM</div>
    </div>
    <nav class="hidden flex-wrap gap-7 text-15 lg:flex">
      {navLinks.map((link) => <a href={link.href} class="text-ink">{link.label}</a>)}
    </nav>
    <a
      href={APP_URL}
      class="rounded-full bg-primary-soft px-3.5 py-2 text-14 font-semibold text-primary-ink lg:bg-primary lg:px-4.5 lg:py-2.5 lg:text-15 lg:text-white lg:hover:bg-primary-hover"
      ><span class="lg:hidden">Открыть</span><span class="hidden lg:inline">Открыть приложение</span></a
    >
  </div>
</header>

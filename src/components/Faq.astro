---
import SectionCard from "./ui/SectionCard.astro";
import SectionTitle from "./ui/SectionTitle.astro";
import { faq } from "../data/content";

const lastIndex = faq.length - 1;
---

<SectionCard
  id="faq"
  class="flex scroll-mt-20 flex-col pb-2 lg:grid lg:grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] lg:gap-x-14 lg:gap-y-4 lg:pb-12"
>
  <SectionTitle class="mb-2 lg:mb-0">Частые вопросы</SectionTitle>
  <div class="flex flex-col">
    {
      faq.map((item, i) => (
        <details class:list={["group", i !== lastIndex && "border-b border-divider"]}>
          <summary
            class:list={[
              "flex cursor-pointer list-none justify-between gap-3 py-4 text-16 font-semibold lg:gap-4 lg:text-17 [&::-webkit-details-marker]:hidden",
              i === 0 && "lg:pt-0 lg:pb-4.5",
              i === lastIndex && "lg:pt-4.5 lg:pb-0",
              i !== 0 && i !== lastIndex && "lg:py-4.5",
            ]}
          >
            {item.question}
            <span
              class="text-22 leading-none font-normal text-primary transition-transform duration-200 group-open:rotate-45 motion-reduce:transition-none lg:text-24"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p
            class:list={[
              "mb-4 text-15 leading-150 text-ink-secondary lg:text-16 lg:leading-155",
              i === lastIndex ? "lg:mt-3 lg:mb-0" : "lg:mb-4.5",
            ]}
          >
            {item.answer}
          </p>
        </details>
      ))
    }
  </div>
</SectionCard>

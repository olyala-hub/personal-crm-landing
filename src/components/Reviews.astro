---
import SectionTitle from "./ui/SectionTitle.astro";
import { reviews } from "../data/content";

const avatarColors = {
  blue: "bg-primary-soft text-primary",
  green: "bg-avatar-green text-avatar-green-ink",
  orange: "bg-avatar-orange text-avatar-orange-ink",
};
---

<section class="flex flex-col gap-2 lg:gap-4">
  <SectionTitle class="mx-2 mt-3 mb-1 text-balance lg:mt-8 lg:mb-2">
    Нашими пользователями уже стали 15 000 человек
  </SectionTitle>
  <div
    class="flex flex-col gap-2 lg:grid lg:grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] lg:gap-3"
  >
    {
      reviews.map((review) => (
        <figure class="flex flex-col gap-3.5 rounded-20 bg-surface p-4.5 lg:gap-4.5 lg:p-7">
          <blockquote class="text-15 leading-150 lg:flex-1 lg:text-17 lg:leading-155">
            {review.text}
          </blockquote>
          {/* The author goes above the quote on phones and below it on desktop */}
          <figcaption class="order-first flex items-center gap-3 lg:order-none">
            <div
              class:list={[
                "flex size-10 items-center justify-center rounded-full font-semibold lg:size-11",
                avatarColors[review.avatar],
              ]}
              aria-hidden="true"
            >
              {review.initials}
            </div>
            <div class="flex flex-col gap-0.5">
              <span class="text-15 font-semibold">{review.name}</span>
              <span class="text-13 text-ink-tertiary lg:text-14">{review.role}</span>
            </div>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
